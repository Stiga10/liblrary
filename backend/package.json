{
  "name": "biblioteka-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "auth:generate": "better-auth generate --config src/lib/auth.ts"
  },
  "prisma": {
